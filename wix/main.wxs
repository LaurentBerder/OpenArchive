<!--
  Please do not remove these pre-processor If-Else blocks. These are used with
  the `cargo wix` subcommand to automatically determine the installation
  destination for 32-bit versus 64-bit installers. Removal of these lines will
  cause installation errors.
-->
<?if $(sys.BUILDARCH) = x64 or $(sys.BUILDARCH) = arm64 ?>
    <?define PlatformProgramFilesFolder = "ProgramFiles64Folder" ?>
<?else ?>
    <?define PlatformProgramFilesFolder = "ProgramFilesFolder" ?>
<?endif ?>

<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>

    <Product
        Id='*'
        Name='OpenArchive'
        UpgradeCode='6718A6D9-05C3-40BC-BB06-32FB69547BCB'
        Manufacturer='Laurent'
        Language='1033'
        Codepage='1252'
        Version='$(var.Version)'>

        <Package Id='*'
            Keywords='Installer'
            Description='A modern, high-performance, modular Rust-backed equivalent of 7-Zip'
            Manufacturer='Laurent'
            InstallerVersion='450'
            Languages='1033'
            Compressed='yes'
            InstallScope='perMachine'
            SummaryCodepage='1252'
            />

        <MajorUpgrade
            Schedule='afterInstallInitialize'
            DowngradeErrorMessage='A newer version of [ProductName] is already installed. Setup will now exit.'/>

        <Media Id='1' Cabinet='media1.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1'/>
        <Property Id='DiskPrompt' Value='OpenArchive Installation'/>

        <!-- Product icon shown in Add/Remove Programs -->
        <Icon Id='ProductICO' SourceFile='$(var.CargoTargetBinDir)\..\..\assets\OpenArchive_favicon.ico'/>
        <Property Id='ARPPRODUCTICON' Value='ProductICO'/>

        <!-- Help/support URL shown in Add/Remove Programs -->
        <Property Id='ARPHELPLINK' Value='https://github.com/openarchive/openarchive'/>

        <Directory Id='TARGETDIR' Name='SourceDir'>
            <Directory Id='$(var.PlatformProgramFilesFolder)' Name='PFiles'>
                <Directory Id='APPLICATIONFOLDER' Name='OpenArchive'>
                    <Directory Id='Bin' Name='bin'>
                        <Component Id='Path' Guid='031ADE69-B6D0-470A-A429-A72CF4941846' KeyPath='yes'>
                            <Environment
                                Id='PATH'
                                Name='PATH'
                                Value='[Bin]'
                                Permanent='no'
                                Part='last'
                                Action='set'
                                System='yes'/>
                        </Component>
                        <Component Id='binary0' Guid='*'>
                            <File
                                Id='exe0'
                                Name='openarchive.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\openarchive.exe'
                                KeyPath='yes'/>
                        </Component>
                        <Component Id='binary1' Guid='*'>
                            <File
                                Id='exe1'
                                Name='openarchive-gui.exe'
                                DiskId='1'
                                Source='$(var.CargoTargetBinDir)\openarchive-gui.exe'
                                KeyPath='yes'/>
                        </Component>
                    </Directory>
                </Directory>
            </Directory>

            <!-- Start Menu shortcut for the GUI -->
            <Directory Id='ProgramMenuFolder'>
                <Directory Id='ApplicationProgramsFolder' Name='OpenArchive'>
                    <Component Id='ApplicationShortcut' Guid='AAC64AAA-00F7-4764-A618-624381CB95F3'>
                        <Shortcut Id='ApplicationStartMenuShortcut'
                            Name='OpenArchive'
                            Description='A modern Rust-backed archive manager'
                            Target='[APPLICATIONFOLDER]bin\openarchive-gui.exe'
                            WorkingDirectory='APPLICATIONFOLDER'
                            Icon='ProductICO'/>
                        <RemoveFolder Id='CleanUpShortCut' Directory='ApplicationProgramsFolder' On='uninstall'/>
                        <RegistryValue Root='HKCU'
                            Key='Software\OpenArchive'
                            Name='installed'
                            Type='integer'
                            Value='1'
                            KeyPath='yes'/>
                    </Component>
                </Directory>
            </Directory>
        </Directory>

        <Feature
            Id='Binaries'
            Title='Application'
            Description='Installs all binaries and the license.'
            Level='1'
            ConfigurableDirectory='APPLICATIONFOLDER'
            AllowAdvertise='no'
            Display='expand'
            Absent='disallow'>

            <ComponentRef Id='binary0'/>
            <ComponentRef Id='binary1'/>
            <ComponentRef Id='ApplicationShortcut'/>

            <Feature
                Id='Environment'
                Title='PATH Environment Variable'
                Description='Add the install location of the [ProductName] executable to the PATH system environment variable. This allows the [ProductName] executable to be called from any location.'
                Level='1'
                Absent='allow'>
                <ComponentRef Id='Path'/>
            </Feature>
        </Feature>

        <SetProperty Id='ARPINSTALLLOCATION' Value='[APPLICATIONFOLDER]' After='CostFinalize'/>

        <UI>
            <UIRef Id='WixUI_FeatureTree'/>
            <!-- Skip EULA dialog: go Welcome -> Customize directly -->
            <Publish Dialog='WelcomeDlg' Control='Next' Event='NewDialog' Value='CustomizeDlg' Order='99'>1</Publish>
            <Publish Dialog='CustomizeDlg' Control='Back' Event='NewDialog' Value='WelcomeDlg' Order='99'>1</Publish>
        </UI>

    </Product>

</Wix>
